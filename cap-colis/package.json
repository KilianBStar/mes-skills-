{
  "name": "cap-colis",
  "version": "1.0.0",
  "private": true,
  "description": "Optimiseur de tournée pour livreur de colis (web + iOS)",
  "scripts": {
    "test": "node --test tests/optimizer.test.js tests/scan.test.js tests/postcodes.test.js",
    "build:web": "node scripts/build-web.mjs",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor-community/background-geolocation": "1.3.0",
    "@capacitor-community/keep-awake": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
